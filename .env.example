# ==============================================================================
# Enterprise IP Manager - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Port used inside the application server (Default: 3000 for local dev, 80 for Docker container)
APP_PORT=3000

# Host Port exposed to external users when running via Docker Compose (Default: 3000)
HOST_PORT=3000

# PostgreSQL Database Connection String
# Leave blank or commented out to automatically use the local disk storage fallback (data/ipam-database.json)
# For Docker Compose, the default connection is:
DATABASE_URL=postgresql://ip_manager_admin:ip_manager_secure_password_2026@ip-manager-db:5432/ip_manager_db

# Path to the data directory for persistent disk database fallback & exports
DATA_DIR=./data
