{
  "name": "ip-manager",
  "version": "2.0.0",
  "description": "Modern full-stack IP Address Management (IPAM) solution with live ping discovery, subnet visualization, and LDAP authentication.",
  "author": "Git-Raheman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Git-Raheman/ip-manager.git"
  },
  "homepage": "https://github.com/Git-Raheman/ip-manager#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.109",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ldapts": "^9.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
